# EV gate: apri il segnale solo se prob * quota - 1 >= EV_MIN_EDGE.
# Agisce solo quando la quota live e' disponibile per il mercato.
EV_GATE_ENABLED=1
EV_MIN_EDGE=0.03
# Bet id API-Football per le quote live dei mercati HT (0 = disabilitato).
# NEXT GOAL LIVE usa gia' bet=5.
LIVE_ODDS_BET_ID_OVER05_HT=0
LIVE_ODDS_BET_ID_OVER15_HT=0
