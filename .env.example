# Copy this file to .env and fill in your real secrets.

TOKEN_LIVE=your_telegram_bot_token
CHAT_ID=your_admin_chat_id
CHANNEL_ID=@your_free_or_main_channel
API_KEY=your_api_football_key
VIP_CHANNEL_ID=@your_vip_channel
VIP_SUPPORT_CONTACT=@your_support

CSV_PATH=Matches.csv
MODEL_PATH=oracle_brain.pkl
WEB_DATA_PATH=web_stats.json
MEMBERS_DB_PATH=vip_members.db
LOG_FILE_PATH=oracle_live.log
LIVE_TRAINING_DATA_PATH=live_training_data.csv
MISSING_TEAMS_QUEUE_PATH=missing_teams_queue.json

STAKE=10.0
QUOTA=1.75
# Quote di fallback per market: usate solo quando il book non espone la quota
# live. Quando la espone, il P/L usa quella reale (colonna OpenOdd).
QUOTA_O05_HT=1.45
QUOTA_O15_HT=1.50
QUOTA_NEXT_GOAL=1.75

# Strato di analisi AI (oracle_ai.py): spiega i segnali e cerca il contesto
# qualitativo che i dati non contengono. NON seleziona le partite.
# Spento di default: senza chiave il bot funziona esattamente come prima.
ORACLE_AI_ENABLED=0
ORACLE_AI_MODEL=claude-opus-5
ANTHROPIC_API_KEY=

# Filtro quote: quota live minima per pubblicare un segnale.
# Sotto la soglia il segnale non copre il breakeven e viene scartato.
MIN_ODD_O05_HT=1.40
MIN_ODD_O15_HT=1.60
MIN_ODD_NEXT_GOAL=1.60
# 1 = scarta anche quando la quota non e' recuperabile. 0 = pubblica e logga.
ODDS_GATE_STRICT=0
# Finestra HT 21-28' sotto pressione: attivare SOLO dopo verifica con analyze_shadow_signals.py
HT_PRESSURE_WINDOW_ENABLED=0
HT_PRESSURE_WINDOW_MAX_MINUTE=28
VIP_PRICE_XTR=499
VIP_DURATION_DAYS=30
FREE_DELAY_SECONDS=180
FREE_EVERY_N_APPROVED=3
RECAP_HOUR_UTC=21
RECAP_MINUTE_UTC=0
RENEWAL_REMINDER_DAYS=3
REPORT_EVERY_N_SETTLED=10
REPORT_MIN_SETTLED=20
PERFORMANCE_STAKE_EXAMPLE=100
PERFORMANCE_STARTING_BANKROLL=1000
AUTO_RETRAIN_EVERY_N_SETTLED=50
# Minuto minimo di apertura per OVER 0.5 HT: prima il book non espone la quota.
MIN_OPEN_MINUTE_O05_HT=9
